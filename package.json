{
  "name": "fcf-platform",
  "version": "1.0.0",
  "description": "Friends of Children and Families - ExtendedReach Reporting & Visualization Platform",
  "private": true,
  "workspaces": [
    "services/api",
    "services/worker"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace=services/api",
    "api:build": "npm run build --workspace=services/api",
    "api:start": "npm run start:prod --workspace=services/api",
    "worker:dev": "npm run start:dev --workspace=services/worker",
    "worker:build": "npm run build --workspace=services/worker",
    "worker:start": "npm run start:prod --workspace=services/worker",
    "prisma:generate": "npm run prisma:generate --workspace=services/api",
    "prisma:migrate": "npm run prisma:migrate:dev --workspace=services/api",
    "prisma:studio": "npm run prisma:studio --workspace=services/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:all": "npm install && cd apps/flutter_app && flutter pub get"
  },
  "keywords": [
    "reporting",
    "case-management",
    "flutter",
    "nestjs"
  ],
  "author": "Melken TechWork",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prisma": "^6.19.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/swagger": "11.2.5",
    "@prisma/client": "^7.2.0",
    "ts-node": "1.7.1"
  }
}
