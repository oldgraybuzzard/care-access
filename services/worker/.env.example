# Database (same as API service)
# Note: Use port 5433 when connecting from host machine to Docker PostgreSQL
# Docker containers use 'postgres:5432' internally
DATABASE_URL="postgresql://fcf_user:fcf_password@localhost:5433/fcf_platform?schema=public"

# Worker Configuration
WORKER_MODE=true
SYNC_INTERVAL_MINUTES=60

# Vendor Integration - ExtendedReach
EXTENDEDREACH_BASE_URL=https://api.extendedreach.com
EXTENDEDREACH_CLIENT_ID=your-client-id
EXTENDEDREACH_CLIENT_SECRET=your-client-secret

# Vendor Integration - Zoho
ZOHO_BASE_URL=https://www.zohoapis.com
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret

# Node
NODE_ENV=development

# Optional: Redis
REDIS_URL=redis://localhost:6379

