// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Identity & Security
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique  // URL-friendly identifier (e.g., "fcf", "acme-child-services")
  domain      String?  @unique  // Custom domain support (optional)

  // Subscription
  plan        String   @default("trial")  // trial, basic, professional, enterprise
  status      String   @default("active") // active, suspended, cancelled
  trialEndsAt DateTime? @map("trial_ends_at")

  // Branding
  logoUrl      String?  @map("logo_url")
  primaryColor String?  @map("primary_color")

  // Business Details
  phone        String?
  email        String?
  website      String?
  address      String?
  city         String?
  state        String?
  zipCode      String?  @map("zip_code")
  country      String?  @default("USA")
  description  String?  // Organization description/mission statement

  // Settings (JSON for flexibility)
  settings    Json?    // Tenant-specific configuration

  // Metadata
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations - all tenant-scoped models
  users            User[]
  clients          Client[]
  children         Child[]
  families         Family[]
  programs         Program[]
  workers          Worker[]
  cases            Case[]
  assessments      Assessment[]
  goals            Goal[]
  educationRecords EducationRecord[]
  medicalRecords   MedicalRecord[]
  incidents        BehavioralIncident[]
  childNotes       ChildNote[]
  homeVisits       HomeVisit[]
  reportDefinitions ReportDefinition[]
  kpiDaily         KpiDaily[]
  vendorSources    VendorSource[]
  documents        Document[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")

  // Multi-tenancy
  // NULL for SuperAdmins (platform administrators)
  // Required for organization users
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Multi-Factor Authentication (MFA)
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  mfaSecret      String?  @map("mfa_secret")
  mfaBackupCodes String[] @default([]) @map("mfa_backup_codes")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roles        UserRole[]
  auditLogs    AuditLog[]
  reportRuns   ReportRun[]
  ownedReports ReportDefinition[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metaJson   Json?    @map("meta_json")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Vendor Integration
// ============================================

model VendorSource {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  tokens          VendorToken[]
  clients         Client[]
  cases           Case[]
  activities      Activity[]
  services        Service[]
  vendorDocuments VendorDocument[]

  @@unique([organizationId, name])  // Name unique per organization
  @@index([organizationId])
  @@map("vendor_sources")
}

model VendorToken {
  id           String    @id @default(uuid())
  sourceId     String    @map("source_id")
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  metaJson     Json?     @map("meta_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  source VendorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("vendor_tokens")
}

// ============================================
// Reference Data
// ============================================

model Program {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  clients  Client[]
  cases    Case[]
  kpiDaily KpiDaily[]

  @@unique([organizationId, name])  // Program name unique per organization
  @@index([organizationId])
  @@map("programs")
}

model Worker {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  cases    Case[]
  kpiDaily KpiDaily[]

  @@unique([organizationId, email])  // Email unique per organization (workers can work for multiple orgs)
  @@index([organizationId])
  @@map("workers")
}

// ============================================
// Cached Entities
// ============================================

model Client {
  id              String   @id @default(uuid())

  // Multi-tenancy
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])

  vendorSourceId  String   @map("vendor_source_id")
  vendorClientId  String   @map("vendor_client_id")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  dob             DateTime?
  programId       String?  @map("program_id")
  status          String
  metaJson        Json?    @map("meta_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendorSource VendorSource @relation(fields: [vendorSourceId], references: [id])
  program      Program?     @relation(fields: [programId], references: [id])
  cases        Case[]
  child        Child?       // New child-centered profile
  documents    Document[]

  @@unique([vendorSourceId, vendorClientId])
  @@index([organizationId])
  @@index([organizationId, status])  // Composite index for common queries
  @@index([programId])
  @@map("clients")
}

model Case {
  id                String    @id @default(uuid())

  // Multi-tenancy
  organizationId    String    @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  vendorSourceId    String    @map("vendor_source_id")
  vendorCaseId      String    @map("vendor_case_id")
  clientId          String    @map("client_id")
  status            String
  openedAt          DateTime  @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  assignedWorkerId  String?   @map("assigned_worker_id")
  programId         String?   @map("program_id")
  metaJson          Json?     @map("meta_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  vendorSource     VendorSource     @relation(fields: [vendorSourceId], references: [id])
  client           Client           @relation(fields: [clientId], references: [id])
  worker           Worker?          @relation(fields: [assignedWorkerId], references: [id])
  program          Program?         @relation(fields: [programId], references: [id])
  activities       Activity[]
  services         Service[]
  vendorDocuments  VendorDocument[]
  documents        Document[]       // User-uploaded documents
  goals            Goal[]           // Child goals linked to case

  @@unique([vendorSourceId, vendorCaseId])
  @@index([organizationId])
  @@index([organizationId, status])  // Composite index for common queries
  @@index([clientId])
  @@index([assignedWorkerId])
  @@index([programId])
  @@index([openedAt])
  @@map("cases")
}

model Activity {
  id                String   @id @default(uuid())
  vendorSourceId    String   @map("vendor_source_id")
  vendorActivityId  String   @map("vendor_activity_id")
  caseId            String   @map("case_id")
  activityType      String   @map("activity_type")
  occurredAt        DateTime @map("occurred_at")
  summary           String?
  metaJson          Json?    @map("meta_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vendorSource VendorSource @relation(fields: [vendorSourceId], references: [id])
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([vendorSourceId, vendorActivityId])
  @@index([caseId])
  @@index([activityType])
  @@index([occurredAt])
  @@map("activities")
}

model Service {
  id               String    @id @default(uuid())
  vendorSourceId   String    @map("vendor_source_id")
  vendorServiceId  String    @map("vendor_service_id")
  caseId           String    @map("case_id")
  serviceType      String    @map("service_type")
  startAt          DateTime  @map("start_at")
  endAt            DateTime? @map("end_at")
  metaJson         Json?     @map("meta_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vendorSource VendorSource @relation(fields: [vendorSourceId], references: [id])
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([vendorSourceId, vendorServiceId])
  @@index([caseId])
  @@index([serviceType])
  @@index([startAt])
  @@map("services")
}

model VendorDocument {
  id                String   @id @default(uuid())
  vendorSourceId    String   @map("vendor_source_id")
  vendorDocumentId  String   @map("vendor_document_id")
  caseId            String   @map("case_id")
  title             String
  docType           String   @map("doc_type")
  metaJson          Json?    @map("meta_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vendorSource VendorSource @relation(fields: [vendorSourceId], references: [id])
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([vendorSourceId, vendorDocumentId])
  @@index([caseId])
  @@index([docType])
  @@map("vendor_documents")
}

// ============================================
// Child-Centered Case Management
// ============================================

model Child {
  id                String    @id @default(uuid())

  // Multi-tenancy
  organizationId    String    @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  clientId          String?   @unique @map("client_id") // Link to legacy Client if exists
  firstName         String    @map("first_name")
  middleName        String?   @map("middle_name")
  lastName          String    @map("last_name")
  nickname          String?
  dateOfBirth       DateTime  @map("date_of_birth")
  gender            String
  raceEthnicity     String?   @map("race_ethnicity")
  preferredLanguage String?   @default("English") @map("preferred_language")
  photoUrl          String?   @map("photo_url")

  // Identifiers
  ssn               String?   @map("ssn") // Encrypted
  medicaidId        String?   @map("medicaid_id")
  schoolId          String?   @map("school_id")

  // Status & Custody
  status            String    @default("Active") // Active, Inactive, Discharged
  custodyStatus     String?   @map("custody_status") // Foster, Kinship, Biological, Group Home
  legalStatus       String?   @map("legal_status") // Court orders, dependency status

  // Referral Information
  referralSource    String?   @map("referral_source")
  referralReason    String?   @map("referral_reason")
  presentingIssues  String?   @map("presenting_issues") @db.Text

  // Medical & Health (JSON for flexibility)
  medications       Json?     // [{name, dosage, frequency, prescriber}]
  allergies         Json?     // [{type, allergen, severity, reaction}]
  medicalConditions Json?     @map("medical_conditions") // [{condition, diagnosis_date, treating_physician}]
  mentalHealthDx    Json?     @map("mental_health_dx") // [{diagnosis, diagnosed_by, date}]

  // Behavioral & Emotional
  triggers          Json?     // [trigger descriptions]
  copingMechanisms  Json?     @map("coping_mechanisms") // [healthy and unhealthy coping]
  traumaHistory     String?   @map("trauma_history") @db.Text
  attachmentStyle   String?   @map("attachment_style")

  // Interests & Strengths
  interests         Json?     // [hobbies, activities they enjoy]
  strengths         Json?     // [positive attributes, talents]
  likes             Json?     // [favorite things]
  dislikes          Json?     // [things they avoid]
  fears             Json?     // [specific fears, anxieties]

  // Emergency Contacts
  emergencyContacts Json?     @map("emergency_contacts") // [{name, relationship, phone}]

  // Family
  familyId          String?   @map("family_id")

  // Metadata
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")

  // Relations
  client            Client?   @relation(fields: [clientId], references: [id])
  family            Family?   @relation(fields: [familyId], references: [id])
  assessments       Assessment[]
  educationRecords  EducationRecord[]
  medicalRecords    MedicalRecord[]
  incidents         BehavioralIncident[]
  goals             Goal[]
  notes             ChildNote[]
  documents         Document[]

  @@index([organizationId])
  @@index([organizationId, status])  // Composite index for common queries
  @@index([familyId])
  @@index([dateOfBirth])
  @@map("children")
}

model Family {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  familyName        String   @map("family_name")
  primaryContact    String?  @map("primary_contact")
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?  @map("zip_code")

  // Living Situation
  housingType       String?  @map("housing_type") // House, Apartment, Shelter, etc.
  housingStatus     String?  @map("housing_status") // Owned, Rented, Temporary, etc.
  householdIncome   String?  @map("household_income") // Income range
  employmentStatus  String?  @map("employment_status")

  // Family Dynamics (JSON for flexibility)
  familyComposition Json?    @map("family_composition") // [{name, relationship, age, living_in_home}]
  supportNetwork    Json?    @map("support_network") // [support people/organizations]
  familyStressors   Json?    @map("family_stressors") // [identified stressors]
  familyStrengths   Json?    @map("family_strengths") // [identified strengths]

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  children          Child[]
  homeVisits        HomeVisit[]

  @@index([organizationId])
  @@map("families")
}

model Assessment {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  assessmentType    String   @map("assessment_type") // Intake, Ongoing, Discharge, etc.
  assessmentDate    DateTime @map("assessment_date")
  assessorId        String?  @map("assessor_id") // User who conducted assessment

  // Assessment Areas (JSON for flexibility)
  emotionalState    Json?    @map("emotional_state")
  behavioralConcerns Json?   @map("behavioral_concerns")
  traumaIndicators  Json?    @map("trauma_indicators")
  familyDynamics    Json?    @map("family_dynamics")
  schoolPerformance Json?    @map("school_performance")
  socialRelationships Json?  @map("social_relationships")
  riskFactors       Json?    @map("risk_factors")
  protectiveFactors Json?    @map("protective_factors")

  // Recommendations
  recommendations   String?  @db.Text
  nextReviewDate    DateTime? @map("next_review_date")

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  documents         Document[]

  @@index([organizationId])
  @@index([childId])
  @@index([assessmentDate])
  @@map("assessments")
}

model EducationRecord {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  schoolYear        String   @map("school_year") // 2023-2024
  schoolName        String   @map("school_name")
  gradeLevel        String   @map("grade_level")

  // Academic Performance
  gpa               Float?
  readingLevel      String?  @map("reading_level")
  mathLevel         String?  @map("math_level")
  strugglingSubjects Json?   @map("struggling_subjects")

  // Attendance & Behavior
  daysPresent       Int?     @map("days_present")
  daysAbsent        Int?     @map("days_absent")
  tardies           Int?
  suspensions       Int?
  detentions        Int?

  // Special Education
  hasIep            Boolean  @default(false) @map("has_iep")
  has504Plan        Boolean  @default(false) @map("has_504_plan")
  specialServices   Json?    @map("special_services")

  // Additional Info
  teacherFeedback   String?  @map("teacher_feedback") @db.Text
  extracurricular   Json?    // [activities, clubs, sports]

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([childId])
  @@index([schoolYear])
  @@map("education_records")
}

model MedicalRecord {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  recordType        String   @map("record_type") // Checkup, Immunization, Specialist Visit, etc.
  recordDate        DateTime @map("record_date")
  provider          String?  // Doctor/clinic name

  // Details
  diagnosis         String?
  treatment         String?  @db.Text
  prescriptions     Json?    // [medications prescribed]
  followUpNeeded    Boolean  @default(false) @map("follow_up_needed")
  followUpDate      DateTime? @map("follow_up_date")

  notes             String?  @db.Text

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([childId])
  @@index([recordDate])
  @@map("medical_records")
}

model BehavioralIncident {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  incidentDate      DateTime @map("incident_date")
  incidentType      String   @map("incident_type") // Aggression, Self-harm, Elopement, etc.
  severity          String   // Minor, Moderate, Severe, Critical

  // Incident Details
  description       String   @db.Text
  location          String?
  trigger           String?  @db.Text
  antecedent        String?  @db.Text // What happened before

  // Response & Outcome
  interventionUsed  String?  @map("intervention_used") @db.Text
  outcome           String?  @db.Text
  injuriesReported  Boolean  @default(false) @map("injuries_reported")
  policeInvolved    Boolean  @default(false) @map("police_involved")

  // Follow-up
  followUpActions   String?  @map("follow_up_actions") @db.Text
  parentNotified    Boolean  @default(false) @map("parent_notified")

  // Metadata
  reportedBy        String?  @map("reported_by") // User ID
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([childId])
  @@index([incidentDate])
  @@index([severity])
  @@map("behavioral_incidents")
}

model Goal {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  caseId            String?  @map("case_id") // Link to case if applicable
  goalCategory      String   @map("goal_category") // Safety, Behavioral, Educational, Family, Life Skills
  goalDescription   String   @map("goal_description") @db.Text

  // Timeline
  startDate         DateTime @map("start_date")
  targetDate        DateTime @map("target_date")
  completedDate     DateTime? @map("completed_date")

  // Status & Progress
  status            String   @default("Active") // Active, Completed, Discontinued
  progressPercent   Int      @default(0) @map("progress_percent") // 0-100

  // Success Criteria
  successCriteria   Json?    @map("success_criteria") // [measurable criteria]
  barriers          Json?    // [identified barriers]
  interventions     Json?    // [interventions being used]

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  case              Case?    @relation(fields: [caseId], references: [id])
  progressNotes     GoalProgress[]

  @@index([organizationId])
  @@index([childId])
  @@index([caseId])
  @@index([status])
  @@map("goals")
}

model GoalProgress {
  id                String   @id @default(uuid())
  goalId            String   @map("goal_id")
  progressDate      DateTime @map("progress_date")
  progressPercent   Int      @map("progress_percent") // 0-100
  progressNote      String   @map("progress_note") @db.Text

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by")

  // Relations
  goal              Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([progressDate])
  @@map("goal_progress")
}

model ChildNote {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  childId           String   @map("child_id")
  noteDate          DateTime @map("note_date")
  noteType          String   @map("note_type") // Progress, Contact, Observation, etc.
  subject           String
  content           String   @db.Text

  // Visibility
  isConfidential    Boolean  @default(false) @map("is_confidential")

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  authorId          String   @map("author_id")

  // Relations
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([childId])
  @@index([noteDate])
  @@index([noteType])
  @@map("child_notes")
}

model HomeVisit {
  id                String   @id @default(uuid())

  // Multi-tenancy
  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  familyId          String   @map("family_id")
  visitDate         DateTime @map("visit_date")
  visitType         String   @map("visit_type") // Scheduled, Unannounced, Emergency

  // Visit Details
  purpose           String?  @db.Text
  observations      String?  @db.Text
  homeCondition     String?  @map("home_condition") // Safe, Concerns, Unsafe
  familyInteraction String?  @map("family_interaction") @db.Text

  // Outcomes
  concernsIdentified Json?   @map("concerns_identified")
  actionItems       Json?    @map("action_items")
  followUpNeeded    Boolean  @default(false) @map("follow_up_needed")
  followUpDate      DateTime? @map("follow_up_date")

  // Metadata
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  conductedBy       String   @map("conducted_by") // User ID

  // Relations
  family            Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([familyId])
  @@index([visitDate])
  @@map("home_visits")
}

// ============================================
// Reporting
// ============================================

model ReportDefinition {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  type           String   // 'standard' | 'custom'
  ownerUserId    String?  @map("owner_user_id")
  definitionJson Json     @map("definition_json")
  isShared       Boolean  @default(false) @map("is_shared")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner User?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  runs  ReportRun[]

  @@index([organizationId])
  @@index([type])
  @@index([ownerUserId])
  @@map("report_definitions")
}

model ReportRun {
  id                   String    @id @default(uuid())
  reportDefinitionId   String    @map("report_definition_id")
  requestedBy          String    @map("requested_by")
  status               String    // 'pending' | 'running' | 'completed' | 'failed'
  startedAt            DateTime  @default(now()) @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  rowCount             Int?      @map("row_count")
  metaJson             Json?     @map("meta_json")

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [requestedBy], references: [id])

  @@index([reportDefinitionId])
  @@index([requestedBy])
  @@index([status])
  @@map("report_runs")
}

// ============================================
// Dashboard KPIs
// ============================================

model KpiDaily {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  programId      String?  @map("program_id")
  workerId       String?  @map("worker_id")
  date           DateTime @db.Date
  activeCases    Int      @default(0) @map("active_cases")
  intakes        Int      @default(0)
  closures       Int      @default(0)
  overdueCount   Int      @default(0) @map("overdue_count")
  createdAt      DateTime @default(now()) @map("created_at")

  program Program? @relation(fields: [programId], references: [id])
  worker  Worker?  @relation(fields: [workerId], references: [id])

  @@unique([organizationId, date, programId, workerId])  // Org-scoped unique constraint
  @@index([organizationId])
  @@index([date])
  @@index([programId])
  @@index([workerId])
  @@map("kpi_daily")
}

// ============================================
// Document Management
// ============================================

model Document {
  id             String   @id @default(uuid())

  // Multi-tenancy
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // File metadata
  filename       String   // Original filename
  storageKey     String   @unique @map("storage_key") // R2 storage key
  mimetype       String   // MIME type (e.g., 'image/jpeg', 'application/pdf')
  size           Int      // File size in bytes

  // Document categorization
  category       String   // 'photo', 'medical', 'legal', 'education', 'case_note', 'report', 'import', 'other'
  description    String?  // Optional description
  tags           String[] @default([]) // Searchable tags

  // Relationships (polymorphic - can be attached to different entities)
  childId        String?  @map("child_id")
  caseId         String?  @map("case_id")
  clientId       String?  @map("client_id")
  assessmentId   String?  @map("assessment_id")

  child          Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  case           Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assessment     Assessment?  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Audit
  uploadedBy     String   @map("uploaded_by") // User ID who uploaded
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([childId])
  @@index([caseId])
  @@index([clientId])
  @@index([assessmentId])
  @@index([category])
  @@index([uploadedBy])
  @@map("documents")
}

